# ---------------------------------------------------------------------------
# Copy this file to .env (`qwen21 install` does that for you) and fill in the
# keys marked TODO. `qwen21 doctor` lists whatever is still missing.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================
# Bearer token every API caller must send:  Authorization: Bearer $API_KEY
# Generate one with:  qwen21 keygen --write
API_KEY=TODO-run-qwen21-keygen-write

# === Cloudflare tunnel (public endpoint) ===================================
# quick = no account needed, random https://<random>.trycloudflare.com URL
# named = stable hostname, needs a Cloudflare account and the token below
# off   = stay on http://127.0.0.1:8000
TUNNEL_MODE=quick

# From Cloudflare Zero Trust -> Networks -> Tunnels -> Create a tunnel.
# The install command it shows ends with a long base64 blob (it starts with
# "eyJh" and decodes to a JSON object). Paste that whole blob here.
#TUNNEL_TOKEN=paste-the-token-from-the-cloudflare-install-command-here

# Only for TUNNEL_MODE=named: a hostname on a zone already on Cloudflare DNS.
#TUNNEL_HOSTNAME=img.example.com

# === Device registry (optional) ============================================
# A quick tunnel gets a NEW random hostname on every restart, so the URL is not
# an identifier - the device is. When the tunnel comes up, qwen21 publishes
# this device's public link to MongoDB and overwrites the previous row for the
# same device, so the collection answers "where is each machine right now".
#
# HOST_NAME must be stable across restarts. Unset means the OS hostname.
#HOST_NAME=my-machine
#
# Atlas -> Database Access -> add a user with read/write on that ONE database
# (and add your IP to Network -> Access List). Paste the SRV string; it stays in
# this file, which is gitignored, and never gets committed.
#MONGODB=mongodb+srv://USER:PASSWORD@cluster.example.net/tunnels
#MONGODB_COLLECTION=devices

# === Hugging Face (optional) ===============================================
# Not needed for the public Qwen-Org repositories. Set it to raise download
# limits or reach a gated repository: huggingface.co/settings/tokens
#HF_TOKEN=hf_TODO

# === ComfyUI (local, never exposed) =======================================
# Keep this on loopback. Only the tunnel publishes the API, not ComfyUI.
COMFY_HOST=127.0.0.1
COMFY_PORT=8188

# === API service ===========================================================
API_HOST=127.0.0.1
API_PORT=8000

# How long a request may block before returning 202 + a job id. Cloudflare's
# proxy read timeout is 125 s (524) and its write timeout 30 s, so stay under
# the read timeout with room to spare.
SYNC_MAX_WAIT=90

# b64 embeds the image in the JSON (default). "url" returns only the download
# URL, saving the 33% base64 inflation on large results.
RESPONSE_FORMAT=b64

# One job at a time (ComfyUI serialises anyway); MAX_QUEUE requests may wait.
MAX_CONCURRENT=1
MAX_QUEUE=8

# Give up on a single job after this many seconds, and forget finished jobs
# (and their files) after JOB_TTL_HOURS.
JOB_TIMEOUT=3600
JOB_TTL_HOURS=24

# 0 disables rate limiting. Counted per API key, per minute.
RATE_LIMIT_PER_MIN=10

# Cloudflare caps a request body at 100 MB on Free/Pro and 200 MB on Business.
# Keep MAX_REQUEST_MB under your plan's cap so this service returns its own
# actionable 413 instead of Cloudflare's error page, and keep
# MAX_UPLOAD_MB x MAX_IMAGES at or below it (doctor fails otherwise).
MAX_REQUEST_MB=90
MAX_UPLOAD_MB=20
MAX_IMAGES=4

# Images are returned from RAM and nothing is written to disk. This bounds how
# much the async (202) path can hold; 64 MB is ~30 x 1024px PNGs, which is
# plenty on an 8GB machine that also has to fit ComfyUI. Set to 0 to retain
# nothing (pollers then get 410 Gone).
IMAGE_CACHE_MB=64
# Debug escape hatch: 1 leaves ComfyUI's rendered files in place to inspect
# them. Never enable this on a machine that must not keep images.
KEEP_IMAGE_FILES=0
# How old a file in ComfyUI's image directories must be before a crash sweep
# removes it. Age-based, so a sweep can never delete a render in flight.
ORPHAN_MAX_AGE_MIN=60
POLL_INTERVAL=1.5

# Where rendered images are kept (defaults to runtime/outputs).
#QWEN_OUTPUT_DIR=

# Absolute base URL to hand back in image URLs. Set it when the tunnel is the
# public entry point and you want absolute links in responses.
#PUBLIC_BASE_URL=https://img.example.com

# Debug knobs
API_LOG_LEVEL=info
API_ACCESS_LOG=0

HOST_NAME=MAC

MONGODB=mongodb://localhost:27017/yourdbcollection